<?xml version="1.0" encoding="utf-8"?>
<!-- Self-update pieces: only in the "direct" build (not allowed on Google Play). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- one-tap "Unrestricted battery" so battery savers don't stop the screen translator (Play build opens the settings list instead) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application>
        <receiver android:name=".UpdateReceiver" android:exported="false" />
        <!-- sent by the system DownloadManager (other uid) when the update APK finishes; APK is SHA-256 checked anyway -->
        <receiver android:name=".UpdateDownloadReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
